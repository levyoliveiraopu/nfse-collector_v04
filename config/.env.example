STORAGE_BACKEND=local
# Diretório efetivo do backend local (também usado como default pelo scripts/sync_output.sh)
LOCAL_OUTPUT_DIR=/var/lib/nfse-collector/output
GOOGLE_CREDENTIALS_JSON=config/google_credentials.json
GOOGLE_DELEGATED_USER_EMAIL=
GOOGLE_DRIVE_FOLDER_ROOT_ID=
RATE_LIMIT_DELAY=3
MAX_DOCUMENTOS_POR_EXECUCAO=0
LOG_LEVEL=INFO
LOG_TO_CONSOLE=true
HTTP_TIMEOUT_SECONDS=30
NSU_ESTADO_PATH=config/estado/ultimo_nsu.json

# Ambiente da API NFS-e ADN:
#   PRODUCAO    = https://adn.nfse.gov.br/contribuintes
#   HOMOLOGACAO = https://adn.producaorestrita.nfse.gov.br/contribuintes
NFSE_AMBIENTE=HOMOLOGACAO

# -----------------------------------------------------------------------------
# Storage S3-compativel (Backblaze B2 primario - ADR-003 / INFRA-06)
# -----------------------------------------------------------------------------
# Ver infra/s3-bucket.md para setup do bucket e das lifecycle rules.
# Nunca commitar valores reais de S3_KEY_ID / S3_APPLICATION_KEY.
S3_ENDPOINT=https://s3.us-west-004.backblazeb2.com
S3_REGION=us-west-004
S3_BUCKET=nfse-saas-prod
S3_KEY_ID=
S3_APPLICATION_KEY=
S3_FORCE_PATH_STYLE=true
# Prefixos irmaos para lifecycle diferenciado (ver INFRA-06 secao 2.3):
#   XMLs de execucoes (retencao 90d) ficam sob S3_EXECUTIONS_PREFIX.
#   Exports (Excel/ZIP, retencao 30d) ficam sob S3_EXPORTS_PREFIX.
S3_EXECUTIONS_PREFIX=tenants/
S3_EXPORTS_PREFIX=tenants-exports/

# -----------------------------------------------------------------------------
# API FastAPI (apps/api - API-01)
# -----------------------------------------------------------------------------
# Todas as variaveis usam prefixo API_. Ver apps/api/README.md.
API_ENVIRONMENT=development
API_LOG_LEVEL=INFO
API_VERSION=0.1.0
# Preenchido automaticamente no build Docker (ARG GIT_COMMIT).
API_GIT_COMMIT=unknown
# URL Postgres usada pela API e pelo Alembic (DATA-01). Use a role
# `app_admin` para migrations e `app_user` para o runtime da API.
# Formato: postgresql+psycopg://USER:PASS@HOST:5432/DBNAME
API_DATABASE_URL=postgresql+psycopg://app_admin:CHANGE_ME@localhost:5432/nfse
