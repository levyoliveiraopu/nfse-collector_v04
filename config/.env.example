STORAGE_BACKEND=local
# Diretório efetivo do backend local (também usado como default pelo scripts/sync_output.sh)
LOCAL_OUTPUT_DIR=/var/lib/nfse-collector/output
GOOGLE_CREDENTIALS_JSON=config/google_credentials.json
GOOGLE_DELEGATED_USER_EMAIL=
GOOGLE_DRIVE_FOLDER_ROOT_ID=
RATE_LIMIT_DELAY=3
MAX_DOCUMENTOS_POR_EXECUCAO=0
LOG_LEVEL=INFO
LOG_TO_CONSOLE=true
HTTP_TIMEOUT_SECONDS=30
NSU_ESTADO_PATH=config/estado/ultimo_nsu.json

# Ambiente da API NFS-e ADN:
#   PRODUCAO    = https://adn.nfse.gov.br/contribuintes
#   HOMOLOGACAO = https://adn.producaorestrita.nfse.gov.br/contribuintes
NFSE_AMBIENTE=HOMOLOGACAO

# -----------------------------------------------------------------------------
# Storage S3-compativel (Backblaze B2 primario - ADR-003 / INFRA-06)
# -----------------------------------------------------------------------------
# Ver infra/s3-bucket.md para setup do bucket e das lifecycle rules.
# Nunca commitar valores reais de S3_KEY_ID / S3_APPLICATION_KEY.
S3_ENDPOINT=https://s3.us-west-004.backblazeb2.com
S3_REGION=us-west-004
S3_BUCKET=nfse-saas-prod
S3_KEY_ID=
S3_APPLICATION_KEY=
S3_FORCE_PATH_STYLE=true
# Prefixos irmaos para lifecycle diferenciado (ver INFRA-06 secao 2.3):
#   XMLs de execucoes (retencao 90d) ficam sob S3_EXECUTIONS_PREFIX.
#   Exports (Excel/ZIP, retencao 30d) ficam sob S3_EXPORTS_PREFIX.
S3_EXECUTIONS_PREFIX=tenants/
S3_EXPORTS_PREFIX=tenants-exports/
# Prefix DEDICADO para PFX cifrados (API-06). Sem lifecycle — credencial e
# viva enquanto a company existir. Owner deve garantir que NAO existe rule
# de expiracao no console B2 para esse prefix (ver infra/s3-bucket.md).
S3_CREDENTIALS_PREFIX=tenants-credentials/

# -----------------------------------------------------------------------------
# API FastAPI (apps/api - API-01)
# -----------------------------------------------------------------------------
# Todas as variaveis usam prefixo API_. Ver apps/api/README.md.
API_ENVIRONMENT=development
API_LOG_LEVEL=INFO
API_VERSION=0.1.0
# Preenchido automaticamente no build Docker (ARG GIT_COMMIT).
API_GIT_COMMIT=unknown
# URL Postgres usada pela API e pelo Alembic (DATA-01). Use a role
# `app_admin` para migrations e `app_user` para o runtime da API.
# Formato: postgresql+psycopg://USER:PASS@HOST:5432/DBNAME
API_DATABASE_URL=postgresql+psycopg://app_admin:CHANGE_ME@localhost:5432/nfse

# -----------------------------------------------------------------------------
# Auth (apps/api - API-02)
# -----------------------------------------------------------------------------
# Segredo HS256 do JWT de acesso. OBRIGATORIO em staging/production
# (Settings.model_validator aborta a startup se estiver vazio fora de
# development). Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
API_JWT_SECRET=
API_JWT_ISSUER=nfse-api
API_JWT_AUDIENCE=nfse-web
# TTL do access token (JWT) em minutos. Default 15.
API_ACCESS_TOKEN_TTL_MINUTES=15
# TTL do refresh token em dias. Default 7.
API_REFRESH_TOKEN_TTL_DAYS=7
# Rate limit do POST /auth/login (formato slowapi: "<count>/<period>").
API_LOGIN_RATE_LIMIT=5/minute

# -----------------------------------------------------------------------------
# Credenciais PFX (apps/api - API-06)
# -----------------------------------------------------------------------------
# KEK (Key Encryption Key) AES-256 em base64 url-safe (32 bytes).
# OBRIGATORIO em staging/production (Settings.model_validator aborta a
# startup). Em development cai para uma KEK fixa de fallback com warning
# alto — NUNCA usar fora de dev. Gere com:
#   python -c "import secrets,base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
API_CREDENTIAL_KEK_B64=
# Tamanho maximo aceito no upload de PFX (defesa contra abuso). Default 1 MiB.
API_CREDENTIAL_MAX_PFX_BYTES=1048576

# -----------------------------------------------------------------------------
# Fila Redis para execucoes (apps/api - API-07)
# -----------------------------------------------------------------------------
# URL do Redis usada pelo POST /executions para enfileirar jobs do worker
# (RQ). Formato: redis://[:password@]host:port/db. Em dev pode apontar para
# o compose local (INFRA-05); em prod aponta para o servico `redis` da stack.
# Se estiver vazia ou offline, POST /executions devolve 502 antes de tocar
# o banco.
API_REDIS_URL=redis://localhost:6379/0
# Nome da fila RQ consumida pelo worker (CORE-05 / API-13).
API_QUEUE_NAME=nfse-executions

# -----------------------------------------------------------------------------
# Worker RQ (apps/worker - API-13)
# -----------------------------------------------------------------------------
# Consumidor RQ da fila configurada em API_REDIS_URL + API_QUEUE_NAME.
# Reutiliza tambem S3_*, API_CREDENTIAL_KEK_B64 (para decifrar PFX) e
# DATABASE_URL (ou API_DATABASE_URL) para conectar ao Postgres com RLS.
#
# Porta do endpoint /healthz exposto para Uptime Kuma (INFRA-07). Responde
# 200 + JSON `{"status":"ok"}` enquanto o processo estiver vivo.
WORKER_HEALTHZ_PORT=8080
# URL do Postgres dedicada ao worker. Se nao setada, cai para
# API_DATABASE_URL / DATABASE_URL. Use a role `app_user` (NOBYPASSRLS) —
# o worker depende de SET LOCAL app.current_tenant para isolar tenants.
WORKER_DATABASE_URL=

# -----------------------------------------------------------------------------
# Seed de dev (apps/api/scripts/seed.py - DATA-07)
# -----------------------------------------------------------------------------
# Senha do user admin@demo.local criado pelo seed idempotente.
# Obrigatorio em API_ENVIRONMENT=staging|production; em development cai
# para fallback "demo12345" com warning ruidoso se deixado vazio.
API_SEED_ADMIN_PASSWORD=

# -----------------------------------------------------------------------------
# Web app (apps/web-app - APP-01)
# -----------------------------------------------------------------------------
# URL da API FastAPI usada pelo client-side (fetch autenticado). Exposta ao
# bundle — nunca colocar segredos aqui.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# URL da API usada pelos Route Handlers do Next (server-side), que proxiam
# signup/login/refresh/logout e gravam o refresh token em cookie httpOnly.
# Em dev pode coincidir com NEXT_PUBLIC_API_BASE_URL; em compose pode apontar
# para o hostname interno (ex: http://api:8000).
API_BASE_URL=http://localhost:8000

# -----------------------------------------------------------------------------
# Observabilidade (INFRA-07 — infra/compose/docker-compose.obs.yml)
# -----------------------------------------------------------------------------
# Runbook: infra/observability.md. Todos os valores reais vivem em
# /srv/nfse/prod/config/.env na VPS — este bloco e so referencia.

# Dominio que serve Grafana e Uptime Kuma atras do Nginx host.
# Ex.: ops.saas.example.com — DNS-only no Cloudflare (ver infra/dns.md).
OBS_DOMAIN=

# Admin do Grafana. GRAFANA_ADMIN_PASSWORD e obrigatorio na subida do
# container (docker-compose.obs.yml aborta se estiver vazio). Gere com:
#   openssl rand -base64 32
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# IP allowlist do server block ops.<DOMINIO> no Nginx. CSV de CIDRs.
# Aplicado manualmente no /etc/nginx/sites-available/ops.conf (template em
# infra/nginx/ops.conf.example). Ex.: "203.0.113.10/32,198.51.100.0/24".
OPS_ALLOWED_IPS=

# Telegram para alertas do Uptime Kuma. Criar bot via @BotFather, adicionar
# ao grupo e obter o chat.id via /getUpdates (ver infra/observability.md).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# -----------------------------------------------------------------------------
# Backup Postgres (INFRA-08 — infra/scripts/backup-postgres.sh)
# -----------------------------------------------------------------------------
# Runbook: infra/backup.md. Valores reais ficam em /srv/nfse/<env>/config/.env
# na VPS e nunca sao commitados.

# Diretorio local onde o script grava o dump antes do upload para o S3.
# Retencao local configuravel abaixo; o upload em si vai para
# s3://$S3_BUCKET/$BACKUP_S3_PREFIX{daily,monthly}/<stamp>.dump[.age]
# (ver lifecycle em infra/s3-lifecycle.json e secao 3 de infra/backup.md).
BACKUP_LOCAL_DIR=/srv/nfse/prod/backups/postgres

# Prefix raiz no bucket. O script concatena `daily/` ou `monthly/` depois.
BACKUP_S3_PREFIX=backups/postgres/

# Quantos dias manter o dump (claro ou cifrado) em disco local.
# Cron roda diario -> 3 dias = janela de seguranca para investigar
# falhas de upload antes do `find -mtime +N -delete`.
BACKUP_RETENTION_LOCAL_DAYS=3

# Arquivo onde o script anexa 1 linha JSON por execucao (sucesso ou
# falha) para ingestao posterior no Loki (INFRA-07). Default coerente
# com a arvore /srv/nfse/<env>/logs/ criada em INFRA-02.
BACKUP_LOG_FILE=/srv/nfse/prod/logs/backup-postgres.log

# Cifra o dump com age (https://age-encryption.org) antes do upload.
# Default 1 em staging/production; use 0 apenas em dev.
BACKUP_ENCRYPT=1

# Chave PUBLICA age (formato age1...). A chave PRIVADA
# (AGE-SECRET-KEY-1...) vive APENAS no cofre (1Password/Bitwarden)
# do owner — perder == backups inserviveis. Gere o par com:
#   age-keygen -o nfse-backup-age.key
# Depois coloque a publica aqui e a privada no cofre. Ver
# infra/backup.md secao 1.2.
BACKUP_AGE_RECIPIENT=

# Caminho para a chave privada age. SO e usado pelo script de RESTORE
# (infra/scripts/restore-postgres.sh), e SO deve ser preenchido
# durante um drill de restore. Em operacao normal, deixe vazio e
# mantenha a chave apenas no cofre.
BACKUP_AGE_IDENTITY=
