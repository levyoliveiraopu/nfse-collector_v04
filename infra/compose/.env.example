# Compose base — .env de exemplo (INFRA-05).
#
# Copie para `.env` no mesmo diretorio e preencha com valores reais:
#
#   cp .env.example .env
#
# `.env` NAO deve ser commitado (ver `.gitignore` neste diretorio e
# `CONTRIBUTING.md`). Em producao, este arquivo vive em
# `/srv/nfse/<env>/config/.env` e e montado read-only pelo Compose.
#
# -----------------------------------------------------------------------------
# Postgres
# -----------------------------------------------------------------------------
# Usuario superuser criado pelo initdb (primeiro boot). Migrations e runtime
# usam roles `app_admin` / `app_user` criados pela migration DATA-01.
POSTGRES_USER=nfse
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=nfse
# Porta publicada em 127.0.0.1 (loopback). Mude se ja houver outro Postgres
# rodando no host (ex: o do apt) competindo pela 5432.
POSTGRES_HOST_PORT=5432

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
# Senha para `requirepass`. Mesmo na rede interna exigimos auth (defesa em
# profundidade). Gere com: python -c "import secrets; print(secrets.token_urlsafe(32))"
REDIS_PASSWORD=CHANGE_ME
# Porta publicada em 127.0.0.1 (loopback).
REDIS_HOST_PORT=6379

# -----------------------------------------------------------------------------
# Deploy aplicacional (PROD-READY item 2)
# -----------------------------------------------------------------------------
DOMAIN=example.com
IMAGE_REGISTRY=ghcr.io/levyoliveiraopu
DEPLOY_TAG=local
API_HOST_PORT=8000
WEB_APP_HOST_PORT=3000
WORKER_HEALTHZ_PORT=8080
SCHEDULER_HEALTHZ_PORT=8081
NEXT_PUBLIC_API_BASE_URL=https://api.example.com

# API/runtime
API_ENVIRONMENT=staging
API_DATABASE_URL=postgresql+psycopg://nfse:CHANGE_ME@postgres:5432/nfse
# Opcional/recomendado em producao: role separada para migrations/DDL.
API_MIGRATION_DATABASE_URL=postgresql+psycopg://nfse:CHANGE_ME@postgres:5432/nfse
API_REDIS_URL=redis://:CHANGE_ME@redis:6379/0
API_JWT_SECRET=CHANGE_ME_32_BYTES_MINIMUM_SECRET_VALUE
API_CREDENTIAL_KEK_B64=CHANGE_ME_BASE64URL_32_BYTES
API_QUEUE_NAME=nfse-executions

# S3/B2
S3_ENDPOINT=https://s3.us-west-004.backblazeb2.com
S3_REGION=us-west-004
S3_BUCKET=nfse-saas-prod
S3_KEY_ID=CHANGE_ME
S3_APPLICATION_KEY=CHANGE_ME
S3_FORCE_PATH_STYLE=true
S3_EXECUTIONS_PREFIX=tenants/
S3_EXPORTS_PREFIX=tenants-exports/
S3_CREDENTIALS_PREFIX=tenants-credentials/
