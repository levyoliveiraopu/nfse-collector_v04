# =============================================================================
# .env do SELF-HOST em VM unica (Oracle Cloud Always Free ou VPS).
#
# NAO edite este arquivo de exemplo diretamente. O script
# `infra/oracle/setup.sh` copia isto para `.env`, gera as senhas/segredos
# automaticamente e substitui SEU_DOMINIO / SEU_EMAIL pelos seus valores.
#
# Se preferir preencher a mao: copie para `.env`, troque tudo que esta como
# CHANGE_ME / SEU_DOMINIO / SEU_EMAIL. NUNCA versione o `.env` real.
# =============================================================================

# -----------------------------------------------------------------------------
# Dominio publico e HTTPS
# -----------------------------------------------------------------------------
# Dominio que aponta (registro A) para o IP publico da VM. Pode ser um
# dominio proprio ou um gratuito (ex: DuckDNS: nfse-teste.duckdns.org).
DOMAIN=SEU_DOMINIO
# E-mail usado pelo Let's Encrypt para avisos de expiracao do certificado.
ACME_EMAIL=SEU_EMAIL
# Porta HTTPS por onde o MinIO (S3) e exposto para downloads pre-assinados.
S3_PUBLIC_PORT=8443

# -----------------------------------------------------------------------------
# Postgres  (senha gerada pelo setup.sh)
# -----------------------------------------------------------------------------
POSTGRES_USER=nfse
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=nfse
POSTGRES_HOST_PORT=5432

# -----------------------------------------------------------------------------
# Redis  (senha gerada pelo setup.sh)
# -----------------------------------------------------------------------------
REDIS_PASSWORD=CHANGE_ME
REDIS_HOST_PORT=6379

# -----------------------------------------------------------------------------
# API / runtime
# -----------------------------------------------------------------------------
API_ENVIRONMENT=staging
API_LOG_LEVEL=INFO
# host `postgres` / `redis` = nomes dos servicos na rede interna do compose.
API_DATABASE_URL=postgresql+psycopg://nfse:CHANGE_ME@postgres:5432/nfse
API_MIGRATION_DATABASE_URL=postgresql+psycopg://nfse:CHANGE_ME@postgres:5432/nfse
API_REDIS_URL=redis://:CHANGE_ME@redis:6379/0
# Segredos gerados pelo setup.sh:
API_JWT_SECRET=CHANGE_ME_32_BYTES_MINIMUM
API_CREDENTIAL_KEK_B64=CHANGE_ME_BASE64URL_32_BYTES
API_QUEUE_NAME=nfse-executions
# Painel e API na MESMA origem => CORS desligado. Se um dia separar em
# subdominios, defina aqui (ex: https://app.SEU_DOMINIO).
API_CORS_ORIGINS=

# Painel: a API fica em /backend do mesmo dominio (sem CORS).
NEXT_PUBLIC_API_BASE_URL=https://SEU_DOMINIO/backend

# -----------------------------------------------------------------------------
# Storage S3  ->  MinIO local (nao precisa de Backblaze/AWS)
# -----------------------------------------------------------------------------
# Endpoint publico do MinIO (mesmo dominio, porta S3_PUBLIC_PORT).
S3_ENDPOINT=https://SEU_DOMINIO:8443
S3_REGION=us-east-1
S3_BUCKET=nfse
# Credenciais do MinIO (= root user/password). Geradas pelo setup.sh.
S3_KEY_ID=CHANGE_ME
S3_APPLICATION_KEY=CHANGE_ME
S3_FORCE_PATH_STYLE=true
S3_EXECUTIONS_PREFIX=tenants/
S3_EXPORTS_PREFIX=tenants-exports/
S3_CREDENTIALS_PREFIX=tenants-credentials/
# Console web de admin do MinIO (so em loopback; acesse via tunel SSH).
MINIO_CONSOLE_PORT=9001

# -----------------------------------------------------------------------------
# Portas de health dos workers (internas)
# -----------------------------------------------------------------------------
WORKER_HEALTHZ_PORT=8080
SCHEDULER_HEALTHZ_PORT=8081

# -----------------------------------------------------------------------------
# Robustez da coleta ADN
# -----------------------------------------------------------------------------
NFSE_ADN_CONNECT_TIMEOUT_SECONDS=10
NFSE_ADN_READ_TIMEOUT_SECONDS=60
NFSE_ADN_RETRY_ATTEMPTS=5
NFSE_ADN_RETRY_BACKOFF_MULTIPLIER=2
NFSE_ADN_RETRY_BACKOFF_MIN_SECONDS=4
NFSE_ADN_RETRY_BACKOFF_MAX_SECONDS=60
API_JOB_TIMEOUT_SECONDS=3600
