# Gerado automaticamente por start.ps1 como .env.local.
# Os valores CHANGE_ME nunca devem ser usados fora de desenvolvimento local.

ENV_FILE=../local/.env.local
LOCAL_HTTP_PORT=3000

POSTGRES_USER=nfse
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=nfse
REDIS_PASSWORD=CHANGE_ME

API_ENVIRONMENT=development
API_LOG_LEVEL=INFO
LOG_LEVEL=INFO
API_DATABASE_URL=postgresql+psycopg://nfse:CHANGE_ME@postgres:5432/nfse
API_MIGRATION_DATABASE_URL=postgresql+psycopg://nfse:CHANGE_ME@postgres:5432/nfse
WORKER_DATABASE_URL=postgresql+psycopg://nfse:CHANGE_ME@postgres:5432/nfse
API_REDIS_URL=redis://:CHANGE_ME@redis:6379/0
API_QUEUE_NAME=nfse-executions
API_JWT_SECRET=CHANGE_ME
API_CREDENTIAL_KEK_B64=CHANGE_ME
API_ALLOW_LOCAL_DEMO_LOGIN=true
API_SEED_ADMIN_PASSWORD=demo12345

NEXT_PUBLIC_API_BASE_URL=/backend
API_BASE_URL=http://api:8000

S3_ENDPOINT=http://s3.localhost:3000
S3_REGION=us-east-1
S3_BUCKET=nfse
S3_KEY_ID=CHANGE_ME
S3_APPLICATION_KEY=CHANGE_ME
S3_FORCE_PATH_STYLE=true
S3_EXECUTIONS_PREFIX=tenants/
S3_EXPORTS_PREFIX=tenants-exports/
S3_CREDENTIALS_PREFIX=tenants-credentials/

NFSE_AMBIENTE=HOMOLOGACAO
NFSE_ADN_CONNECT_TIMEOUT_SECONDS=10
NFSE_ADN_READ_TIMEOUT_SECONDS=60
NFSE_ADN_RETRY_ATTEMPTS=5
NFSE_ADN_RETRY_BACKOFF_MULTIPLIER=2
NFSE_ADN_RETRY_BACKOFF_MIN_SECONDS=4
NFSE_ADN_RETRY_BACKOFF_MAX_SECONDS=60
API_JOB_TIMEOUT_SECONDS=3600
